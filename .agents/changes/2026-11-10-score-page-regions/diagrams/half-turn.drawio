<mxfile><diagram name="half-turn"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Video: one spread per stable segment. Only ONE half changes per page turn (green = new page).&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="0:06" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="150" height="20" as="geometry"/></mxCell><mxCell id="c5" value="p1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="75" height="100" as="geometry"/></mxCell><mxCell id="c6" value="p2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="75" width="75" height="100" as="geometry"/></mxCell><mxCell id="c7" value="0:22" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="150" height="20" as="geometry"/></mxCell><mxCell id="c8" value="p3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="75" width="75" height="100" as="geometry"/></mxCell><mxCell id="c9" value="p2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#999999;fontSize=16;" vertex="1" parent="1"><mxGeometry x="275" y="75" width="75" height="100" as="geometry"/></mxCell><mxCell id="c10" value="0:28" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="150" height="20" as="geometry"/></mxCell><mxCell id="c11" value="p3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;font